APP_NAME=REDFLOW
APP_ENV=local
APP_KEY=

APP_DEBUG=true
APP_URL=http://localhost:8000


APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# XAMPP/local MySQL defaults — adjust if different
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redflow_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120


MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@redflow.local"
MAIL_FROM_NAME="${APP_NAME}"
